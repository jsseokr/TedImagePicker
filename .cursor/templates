## 6. RxJava 스타일 메서드
```kotlin
fun startNewFeature(): Single<String> {
    return Single.create { emitter ->
        try {
            // 비동기 처리 로직
            val result = processNewFeature()
            emitter.onSuccess(result)
        } catch (e: Exception) {
            emitter.onError(e)
        }
    }
}
```

## 7. 권한 처리
```kotlin
private fun checkNewFeaturePermission() {
    TedPermission.create()
        .setPermissionListener(object : PermissionListener {
            override fun onPermissionGranted() {
                // 권한 승인 시 처리
            }
            
            override fun onPermissionDenied(deniedPermissions: ArrayList<String>) {
                // 권한 거부 시 처리
            }
        })
        .setDeniedMessage("새 기능을 사용하려면 권한이 필요합니다.")
        .setPermissions(Manifest.permission.NEW_PERMISSION)
        .check()
}
```

